# Postgres server shared by the Go services; each creates and owns its own
# database on it (USERS_DB_NAME, CONTENT_DB_NAME, LISTINGS_DB_NAME,
# TRAILS_DB_NAME).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=parcel_bot
POSTGRES_PASSWORD=change_me
# The database of the former NestJS API. The services copy their data out of
# it once, on first start (LEGACY_DB_NAME); the deploy then backs it up to
# ./backups and drops it (scripts/drop-legacy-db.sh).
POSTGRES_DB=parcel_bot

# services/gateway - the public API the frontend apps call. In Docker it listens
# on API_PORT; locally `pnpm dev:gateway` uses :3001 (override with PORT) and the services' default
# ports (override with MEDIA_URL, CONTENT_URL, LISTINGS_URL, USERS_URL,
# TRAILS_URL).
API_PORT=3001
# Optional: CIDRs of proxies (nginx) trusted for client IPs in logs.
# TRUSTED_PROXIES=127.0.0.1
# LOG_LEVEL=info
# Allowed frontend origins, for CORS.
ADMIN_ORIGIN=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3002
# More origins, comma-separated: e.g. the dev servers (`pnpm dev:site` on
# :3012, `pnpm dev:panel` on :3013).
# EXTRA_ORIGINS=http://localhost:3012,http://localhost:3013

# Session tokens (all services verify them; users signs them).
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h

# services/users - accounts, sign-in, registration, partners, support
# contacts. HTTP on PORT (8084), internal gRPC on GRPC_PORT (9083) for the
# other services and the bot, which reach it through USERS_GRPC_ADDR.
# Plain-text password for the admin panel.
ADMIN_PASSWORD=change_me
# COOKIE_SECURE=true marks session cookies Secure (set in production).
# Email verification codes, sent via Resend (https://resend.com). Phone
# registrations are confirmed through a Telegram deep link instead.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Ermekten <onboarding@resend.dev>
# USERS_DB_NAME=users
# USERS_GRPC_ADDR=localhost:9083

# services/bot (the Telegram bot), services/users (Telegram login widget/Mini App
# signature verification)
BOT_TOKEN=your_telegram_bot_token_from_botfather

# services/bot - URL of the Ermekten Mini App (apps/site); the bot uses
# this to show a "web_app" chat menu button + keyboard button that open it.
# Leave unset to skip registering the Mini App button.
MINI_APP_URL=http://localhost:3002
# services/bot - the tours and blog sections call the gateway on
# users' behalf (sessions signed with JWT_SECRET); without API_URL they are
# off. Everything is done in the chat: PUBLIC_API_URL is only for cover
# pictures Telegram fetches. The bot keeps blog subscribers in its own
# database (BOT_DB_NAME, on the POSTGRES_* server).
# API_URL=http://localhost:3001
# PUBLIC_API_URL=http://localhost:3001
# BOT_DB_NAME=bot

# services/content - blog, written guides, gallery, page SEO. MEDIA_GRPC_ADDR
# lets it delete removed gallery photos from R2 through media.
# CONTENT_DB_NAME=content
# MEDIA_GRPC_ADDR=localhost:9081

# services/listings - hotels, local guides, tours, reviews, listing posts.
# Travelers sign up for tours; with BOT_TOKEN set it sends Telegram
# notifications about sign-ups, reminders and rating requests (to users with
# a linked Telegram account); their buttons open the tour in the bot.
# Internal gRPC on GRPC_PORT (9082), for payments (LISTINGS_GRPC_ADDR).
# LISTINGS_DB_NAME=listings

# services/payments - online payments for bookings, partner payouts.
# PAYMENTS_PROVIDER=fake shows a test payment page instead of the bank (no
# money moves); "off" turns online payment off (the site hides booking — the
# production default until the gateway is connected); "gopay" takes payments
# through GoPay (ELQR, https://doc.gopay.kg/v1/); "bakai" through Bakai Bank
# Open Banking (https://openbanking-api.bakai.kg/swagger; BAKAI_QR_TYPE is the
# qrType of payment links for status checks — ask the bank).
PAYMENTS_PROVIDER=fake
# GoPay: one host for both modes — the key pair picks Test (staging, no money
# moves; the amount picks the outcome: 200.00 cancelled, 300.00 expired,
# 400.00 failed, anything else paid) or Live (production). Keys and the
# webhook secret are in the GoPay dashboard (Developer); its events_url is
# <API>/payments/gopay/events with payment.committed, .failed, .expired and
# .cancelled. Never commit them.
# GOPAY_API_URL=https://api.gopay.kg
# GOPAY_API_KEY=
# GOPAY_SECRET_KEY=
# GOPAY_WEBHOOK_SECRET=
# BAKAI_LOGIN=
# BAKAI_PASSWORD=
# BAKAI_QR_TYPE=
# BAKAI_API_URL=https://openbanking-api.bakai.kg
# The platform's commission on bookings, in percent.
PLATFORM_FEE_PERCENT=0
# PAYMENT_TTL_MINUTES=30
# PAYMENTS_DB_NAME=payments

# services/trails - route catalog and trail condition reports.
# TRAILS_DB_NAME=trails

# services/media - local uploads directory (a volume in docker-compose).
UPLOADS_DIR=./uploads
# Thumbnails (/images/<width>/…) are made on first request and cached here
# (default: <UPLOADS_DIR>/.thumbs); THUMB_CONCURRENCY resizes at a time.
# THUMBS_DIR=./uploads/.thumbs
# THUMB_CONCURRENCY=2
# Cloudflare R2 (direct-to-bucket presigned uploads). Create an API token
# under R2 > Manage API Tokens (Object Read & Write, scoped to the bucket
# below); R2_ACCOUNT_ID is the hex id shown on the R2 overview page.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Public base URL for reading uploaded files back (an r2.dev subdomain, or a
# custom domain you've connected to the bucket) — no trailing slash. The
# site gets it too: images there are shown as thumbnails.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# apps/site, apps/panel read their settings at runtime from the container
# environment, not at build time; docker-compose*.yml hand these to them as
# API_BASE_URL, SITE_URL and TELEGRAM_BOT_USERNAME.
# The gateway's public URL (site and panel).
PUBLIC_API_BASE_URL=http://localhost:3001
# The site's public URL: canonical/hreflang tags, sitemap, links in
# notifications (trails, payments).
PUBLIC_SITE_URL=http://localhost:3002
# Bot username (no @) for the Telegram Login Widget on the site.
PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username
# The site's developer menu (a triple click on the version in the footer):
# SHA-256 of its password, hex — `printf '%s' 'password' | shasum -a 256`.
# Empty: no menu.
DEV_MENU_PASSWORD_HASH=
# Firebase Analytics (Google Analytics 4). The site loads it in the browser
# once a visitor accepts analytics cookies, from its web app's config
# (Firebase console > Project settings > Your apps > Web app). The bot sends
# its events to the same web stream through the Measurement Protocol, with
# an API secret created under GA4 Admin > Data streams > the stream >
# Measurement Protocol API secrets; ANALYTICS_SALT (any long random string)
# keys the hash that stands for a chat id there. Empty: analytics off.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_MEASUREMENT_ID=
GA_API_SECRET=
ANALYTICS_SALT=
# Host ports of the site and the panel in Docker. Deploys publish them (and
# API_PORT) on BIND_ADDRESS, 127.0.0.1 by default: reachable through nginx
# only.
# CLIENT_PORT=3002
# ADMIN_PORT=3000
