# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=parcel_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=parcel_bot

# apps/api
API_PORT=3001
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=12h
# plain-text admin password used to log in to the admin panel
ADMIN_PASSWORD=change_me

# apps/bot, apps/api (Telegram login widget/Mini App signature verification)
BOT_TOKEN=your_telegram_bot_token_from_botfather

# apps/tourism (Nuxt) - bot username (no @) for the Telegram Login Widget
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# apps/bot - URL of the Ermekten Mini App (apps/tourism site); the bot uses
# this to show a "web_app" chat menu button + keyboard button that open it.
# Leave unset to skip registering the Mini App button.
MINI_APP_URL=http://localhost:3002

# services/gateway - public API entry point. In Docker it listens on API_PORT
# and proxies to the NestJS API; for local runs see `pnpm dev:gateway`.
# LEGACY_API_URL=http://localhost:3001
# Optional: CIDRs of proxies (nginx) trusted for client IPs in logs.
# TRUSTED_PROXIES=127.0.0.1
# LOG_LEVEL=info

# apps/api, services/gateway - allowed frontend origins, for CORS
ADMIN_ORIGIN=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3002
# apps/api - directory where uploaded images are stored (mounted as a volume in docker-compose)
UPLOADS_DIR=./uploads

# apps/api - email verification codes, sent via Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Ermekten <onboarding@resend.dev>

# apps/api - phone registrations are verified via a Telegram deep link
# (opened from the site, confirmed by the bot process) — no extra
# credentials needed beyond BOT_TOKEN above.

# apps/api - Cloudflare R2 (direct-to-bucket presigned uploads). Create an
# API token under R2 > Manage API Tokens (Object Read & Write, scoped to the
# bucket below); R2_ACCOUNT_ID is the hex id shown on the R2 overview page.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Public base URL for reading uploaded files back (an r2.dev subdomain, or a
# custom domain you've connected to the bucket) — no trailing slash.
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# apps/admin (Nuxt)
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# apps/tourism (Nuxt) - public URL used to generate hreflang/SEO tags for each locale
NUXT_PUBLIC_SITE_URL=http://localhost:3002
