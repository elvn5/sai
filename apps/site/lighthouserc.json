{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4600 SITE_URL=https://ermekten.com node dist/site/server/server.mjs",
      "startServerReadyPattern": "site listening",
      "url": ["http://localhost:4600/", "http://localhost:4600/en"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
