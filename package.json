{
  "name": "ermekten",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.15"
  },
  "scripts": {
    "dev:bot": "cd services/bot && go run ./cmd/bot",
    "dev:admin": "pnpm --filter @app/admin dev",
    "dev:tourism": "pnpm --filter @app/tourism dev",
    "dev:site": "pnpm --filter @app/site dev",
    "dev:panel": "pnpm --filter @app/panel dev",
    "dev:gateway": "cd services/gateway && MEDIA_URL=${MEDIA_URL:-http://localhost:8081} CONTENT_URL=${CONTENT_URL:-http://localhost:8082} LISTINGS_URL=${LISTINGS_URL:-http://localhost:8083} USERS_URL=${USERS_URL:-http://localhost:8084} TRAILS_URL=${TRAILS_URL:-http://localhost:8085} PAYMENTS_URL=${PAYMENTS_URL:-http://localhost:8086} EXTRA_ORIGINS=${EXTRA_ORIGINS:-http://localhost:3012,http://localhost:3013} go run ./cmd/gateway",
    "dev:media": "cd services/media && go run ./cmd/media",
    "dev:content": "cd services/content && go run ./cmd/content",
    "dev:listings": "cd services/listings && go run ./cmd/listings",
    "dev:trails": "cd services/trails && go run ./cmd/trails",
    "dev:payments": "cd services/payments && go run ./cmd/payments",
    "dev:users": "cd services/users && go run ./cmd/users",
    "proto:generate": "cd services/proto && go run github.com/bufbuild/buf/cmd/buf@v1.57.2 generate",
    "test:go": "cd services && go test ./pkg/... ./proto/... ./gateway/... ./media/... ./content/... ./listings/... ./users/... ./trails/... ./payments/... ./bot/...",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.2"
  }
}
